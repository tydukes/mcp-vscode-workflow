{
  "name": "MCP VS Code Workflow",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${env:HOME}/.vscode-server,target=/home/dev/.vscode-server,type=bind",
    "source=${env:HOME}/.config,target=/home/dev/.config,type=bind"
  ],
  "remoteUser": "dev",
  "features": {},
  "postCreateCommand": "pip install -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.pythonPath": "/usr/local/bin/python3"
      }
    }
  }
}
